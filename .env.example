# Copie para .env e troque todos os valores:  cp .env.example .env
# O .env está no .gitignore e nunca vai para o Git. Use só letras e números nas senhas
# (elas entram na URL do banco).

# Banco (PostgreSQL)
POSTGRES_USER=access
POSTGRES_PASSWORD=troque-senha-banco
POSTGRES_DB=access

# Broker (Mosquitto): um usuário por dispositivo, usuário = deviceId
MQTT_SENHA_BACKEND=troque-senha-backend
MQTT_SENHA_PORTA_01=troque-senha-porta01
MQTT_SENHA_JANELA_01=troque-senha-janela01

# API: segredo do JWT com 32 caracteres ou mais (ex.: openssl rand -hex 32)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-senha-admin
OPERADOR_USUARIO=operador
OPERADOR_SENHA=troque-senha-operador

# Notificação externa (R15): tópico do ntfy.sh assinado no celular. Vazio desliga.
NTFY_TOPICO=
